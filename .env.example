# ===== AutoResearch 环境配置 =====
# 复制为 .env 后按需修改；所有变量前缀 AUTORESEARCH_

# --- 数据库 ---
# 留空 = SQLite 零依赖本地模式（默认，无需 Docker）
# Docker Compose 启动 PostgreSQL 后填写：
#   AUTORESEARCH_DATABASE_URL=postgresql://autoresearch:autoresearch@localhost:5432/autoresearch
AUTORESEARCH_DATABASE_URL=
# SQLite 文件位置（仅 DATABASE_URL 为空时生效）
AUTORESEARCH_SQLITE_PATH=data/autoresearch.db

# --- LLM（OpenAI-compatible，本地优先）---
# Ollama 示例:   http://localhost:11434/v1   api_key=ollama
# DeepSeek 示例: https://api.deepseek.com/v1
# OpenAI 示例:   https://api.openai.com/v1
AUTORESEARCH_LLM_BASE_URL=http://localhost:11434/v1
AUTORESEARCH_LLM_API_KEY=ollama
AUTORESEARCH_LLM_MODEL=qwen2.5:7b
AUTORESEARCH_LLM_TIMEOUT=120
AUTORESEARCH_LLM_MAX_CONCURRENCY=4
AUTORESEARCH_LLM_TEMPERATURE=0.3
# 设为 false 可完全关闭 LLM（抽取走启发式，离线可跑）
AUTORESEARCH_LLM_ENABLED=true
# 提示词版本号：参与缓存 key，改提示词必须升版本，避免读到旧答案
AUTORESEARCH_PROMPT_VERSION=v0

# --- 嵌入 / 重排模型（可独立配置 base_url 与 key）---
AUTORESEARCH_EMBED_BASE_URL=http://localhost:11434/v1
AUTORESEARCH_EMBED_API_KEY=ollama
AUTORESEARCH_EMBED_MODEL=BAAI/bge-m3
AUTORESEARCH_RERANK_BASE_URL=http://localhost:11434/v1
AUTORESEARCH_RERANK_API_KEY=ollama
AUTORESEARCH_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# --- 文献检索 / 分块（阶段 1）---
AUTORESEARCH_LITERATURE_MAX_RESULTS=50
AUTORESEARCH_HTTP_TIMEOUT=30
AUTORESEARCH_CHUNK_SIZE=1200
AUTORESEARCH_CHUNK_OVERLAP=150
# 可选 GROBID 服务地址；留空 = 仅 pymupdf
AUTORESEARCH_GROBID_URL=

# --- API / UI ---
AUTORESEARCH_API_HOST=127.0.0.1
AUTORESEARCH_API_PORT=8000
AUTORESEARCH_UI_PORT=8501

# --- 实验（阶段 4/5）---
# 逗号分隔：sklearn 内置数据集（iris/wine/breast_cancer/digits）或 openml 数据集名
AUTORESEARCH_EXPERIMENT_DATASETS=iris,wine,breast_cancer
AUTORESEARCH_EXPERIMENT_FOLDS=5
AUTORESEARCH_EXPERIMENT_SEEDS=0,1,2
AUTORESEARCH_EXPERIMENT_TIMEOUT=900
# strict（默认）：Docker 不可用或执行失败都不在宿主机执行生成代码
# safe-local：仅适合本地开发，允许生成的受控实验包使用本地执行器
# unsafe-local：不建议，允许本地执行任意实验工作区代码
AUTORESEARCH_EXECUTION_MODE=strict
# 是否尝试 Docker 沙箱；生产环境建议保持 true
AUTORESEARCH_SANDBOX_ENABLED=true
AUTORESEARCH_ALLOW_NETWORK=false
AUTORESEARCH_MAX_OUTPUT_BYTES=200000
# Docker 沙箱资源限制
AUTORESEARCH_SANDBOX_CPUS=1.0
AUTORESEARCH_SANDBOX_MEMORY=1g
AUTORESEARCH_SANDBOX_IMAGE=python:3.12-slim

# --- 路径 ---
AUTORESEARCH_DATA_DIR=data
AUTORESEARCH_LLM_CACHE_DIR=data/cache/llm

# --- 文献 API ---
AUTORESEARCH_LITERATURE_MAX_RESULTS=50
AUTORESEARCH_ARXIV_API=http://export.arxiv.org/api/query
AUTORESEARCH_SEMANTIC_SCHOLAR_API=https://api.semanticscholar.org/graph/v1
AUTORESEARCH_SEMANTIC_SCHOLAR_KEY=
AUTORESEARCH_PUBMED_API=https://eutils.ncbi.nlm.nih.gov/entrez/eutils
